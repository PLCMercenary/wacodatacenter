{{- $pages := .RegularPages -}}
{{- if .IsHome -}}{{- $pages = partial "listed-posts.html" . -}}{{- end -}}
{{- $pages = where $pages "Params.unlisted" "ne" true -}}
{{- printf "<?xml version=\"1.0\" encoding=\"utf-8\" standalone=\"yes\"?>" | safeHTML }}
<rss version="2.0" xmlns:atom="http://www.w3.org/2005/Atom"><channel>
<title>{{ .Title }}</title><link>{{ .Permalink }}</link><description>{{ .Description | default .Site.Params.description }}</description><language>en-us</language>
{{ with .OutputFormats.Get "RSS" }}<atom:link href="{{ .Permalink }}" rel="self" type="application/rss+xml"/>{{ end }}
{{ range $pages.ByDate.Reverse }}<item><title>{{ .Title }}</title><link>{{ .Permalink }}</link><pubDate>{{ .Date.Format "Mon, 02 Jan 2006 15:04:05 -0700" }}</pubDate><guid>{{ .Permalink }}</guid><description>{{ .Description | default .Summary | htmlEscape }}</description></item>{{ end }}
</channel></rss>
